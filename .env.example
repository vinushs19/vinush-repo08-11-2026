# ==============================================================================
# AI-Based College Resource Finder — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or set these environment variables in your Windows system.
# DO NOT commit real secrets, passwords, or production credentials to version control.
# ==============================================================================

# ---- Server Configuration ----
SERVER_PORT=8080

# ---- MySQL Database Configuration ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=college_resource_finder
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# ---- JPA / Hibernate Options (dev / prod) ----
JPA_SHOW_SQL=false
JPA_DDL_AUTO=validate

# ---- Flyway Database Migration ----
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true

# ---- Local File Storage Engine ----
# Relative to backend directory (or absolute path such as C:/college_resource_finder/storage)
STORAGE_DIR=../storage
ALLOWED_EXTENSIONS=pdf,docx,pptx,txt,xlsx,csv
MAX_FILE_SIZE_MB=50
